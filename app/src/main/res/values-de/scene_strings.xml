    <string name="scene_hood_short_name">HOOD</string>
    <string name="scene_hood_name">HOOD Night</string>
    <string name="scene_hood_description">Ein älteres Backsteinviertel bei Nacht, mit Feuerleitern, eingezäuntem Hof, geflicktem Asphalt und optionalen Vorfällen, die jede Nacht anders verlaufen.</string>
