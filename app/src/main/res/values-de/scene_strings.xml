    <string name="scene_ferry_spatial_hint">Motorpräsenz, leise Deckgeräusche, Wellenstruktur und Nachttiefe prägen die Überfahrt zwischen den eigenen Abfahrts- und Ankunftsaufnahmen.</string>
    <string name="scene_spacecraft_short_name">Raumschiff</string>
    <string name="scene_spacecraft_name">Driften im Raumschiff</string>
    <string name="scene_spacecraft_description">Die Umlaufbahn verlassen, lange durch den tiefen Weltraum driften, dem Ziel näherkommen und ruhig andocken.</string>
    <string name="scene_spacecraft_asset_unavailable">Diese Version enthält keine Raumschiffaufnahmen.</string>
