    <string name="scene_spacecraft_spatial_hint">Antriebspräsenz und Rumpfklänge formen eine gleichmäßige, schlaffreundliche Innenraumkulisse ohne abrupte Zufallsereignisse.</string>
    <string name="scene_submarine_short_name">U-Boot</string>
    <string name="scene_submarine_name">U-Boot-Reise</string>
    <string name="scene_submarine_description">Unter die Oberfläche tauchen, mit seltenem Sonar durch die Tiefe fahren und zur ruhigen Ankunft wieder auftauchen.</string>
    <string name="scene_submarine_asset_unavailable">Diese Version enthält keine U-Boot-Aufnahmen.</string>
