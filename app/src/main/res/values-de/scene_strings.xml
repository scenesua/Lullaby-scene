    <string name="scene_ferry_short_name">Fähre</string>
    <string name="scene_ferry_name">Nachtfährenreise</string>
    <string name="scene_ferry_description">Ablegen, den Hafen verlassen, das dunkle Meer überqueren und bei der Ankunft an der Küste erwachen.</string>
    <string name="scene_ferry_asset_unavailable">Diese Version enthält keine Aufnahmen für die Nachtfähre.</string>
